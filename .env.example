DATABASE_URL="postgresql://finanzas:finanzas@localhost:5433/finanzas?schema=public"
PORT=3000
CORS_ORIGIN="http://localhost:5173"
API_URL="http://localhost:3000"
BCCR_API_URL="https://apim.bccr.fi.cr"
BCCR_TOKEN=""

# Firma las sesiones. Obligatoria: sin esto la API no arranca, a propósito.
# Generar con: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
AUTH_BASE_URL="http://localhost:3000"

# Opcionales: sin DSN la app corre igual y no reporta nada a Sentry.
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"

# Quién administra la instancia: ids de usuario separados por comas, no correos (los correos
# no se verifican). Sin esto nadie administra y no se pueden dar cuentas nuevas. El id sale de
# la base, después de crear la primera cuenta:
#   SELECT id FROM "authUser" WHERE email = 'tu@correo';
ADMIN_USER_IDS=""

# Sin las credenciales de R2, los comprobantes van al disco de esta máquina, y eso solo se
# acepta si se pide: con otro valor, o sin la variable, la API no arranca.
NODE_ENV="development"
