generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum DebtKind {
  FRENCH
  FIXED_PRINCIPAL
  INTEREST_FREE
}

enum Compounding {
  MONTHLY
  ANNUAL
}

enum DebtDirection {
  BORROWED
  LENT
}

model Debt {
  id             String        @id @default(uuid(7))
  bookId         String
  name           String
  counterparty   String
  principalMinor BigInt
  currency       String        @db.Char(3)
  annualRate     Decimal       @db.Decimal(9, 6)
  compounding    Compounding
  termMonths     Int
  startDate      DateTime      @db.Date
  kind           DebtKind
  direction      DebtDirection @default(BORROWED)
  budgetBucket   String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  book           Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId, direction])
  @@map("debts")
}

model ExchangeRate {
  id          String   @id @default(uuid(7))
  indicator   String   @db.Char(3)
  value       Decimal  @db.Decimal(14, 6)
  publishedAt DateTime @db.Date
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([indicator, publishedAt])
  @@index([indicator, publishedAt(sort: Desc)])
  @@map("exchange_rates")
}

enum AccountClass {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  COST_OF_REVENUE
  OPERATING_EXPENSE
}

enum EntrySide {
  DEBIT
  CREDIT
}

enum CategoryKind {
  EXPENSE
  INCOME
}

enum MovementStatus {
  ACTIVE
  VOIDED
}

enum PeriodStatus {
  OPEN
  CLOSED
}

model Account {
  // La clave es el libro más el código, no el código solo: dos libros tienen los dos su
  // cuenta 1101, y con `code` de clave primaria el segundo libro no podría existir. Se
  // conserva el código como identificador legible en vez de meter un uuid, porque es lo que
  // hace usable un plan de cuentas.
  bookId           String
  code             String
  name             String
  accountClass     AccountClass
  parentCode       String?
  active           Boolean      @default(true)
  sortOrder        Int          @default(0)
  // Una cuenta puente no guarda plata: registra el tránsito de una moneda a otra. Sus dos
  // lados son el mismo hecho contado en dos monedas, y por eso se valúan a la tasa del día
  // en que ocurrió y no a la de hoy.
  isCurrencyBridge Boolean      @default(false)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)

  // El árbol de cuentas no cruza de libro: el padre se busca dentro del mismo `bookId`.
  parent   Account?      @relation("AccountTree", fields: [bookId, parentCode], references: [bookId, code])
  children Account[]     @relation("AccountTree")
  lines    JournalLine[]
  book     Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([bookId, code])
  @@index([bookId, parentCode])
  @@index([bookId, accountClass])
  @@map("accounts")
}

model JournalEntry {
  id               String   @id
  bookId           String
  date             DateTime @db.Date
  description      String
  reference        String?
  sourceMovementId String?
  reversesEntryId  String?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  lines JournalLine[]
  book  Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId, date])
  @@index([bookId, sourceMovementId])
  @@map("journal_entries")
}

model JournalLine {
  id          String    @id @default(uuid(7))
  bookId      String
  entryId     String
  accountCode String
  currency    String    @db.Char(3)
  amountMinor BigInt
  side        EntrySide

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  // Compuesta porque la cuenta ahora se identifica por libro y código: sin el `bookId` acá,
  // una línea podría apuntar a la cuenta 1101 de otro libro.
  account Account      @relation(fields: [bookId, accountCode], references: [bookId, code])
  book    Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId, accountCode, currency])
  @@index([entryId])
  @@map("journal_lines")
}

model Category {
  id          String       @id @default(uuid(7))
  bookId      String
  name        String
  kind        CategoryKind
  accountCode String?
  sortOrder   Int          @default(0)
  active      Boolean      @default(true)

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  // El libro entra en la unicidad: sin él, dos familias no podrían tener las dos una
  // categoría «Comida».
  @@unique([bookId, name, kind])
  @@map("categories")
}

model Movement {
  id                 String         @id
  bookId             String
  date               DateTime       @db.Date
  kind               CategoryKind
  categoryId         String
  counterparty       String
  amountMinor        BigInt
  currency           String         @db.Char(3)
  paymentAccountCode String?
  receiptUrl         String?
  status             MovementStatus @default(ACTIVE)
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  book               Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId, date])
  @@index([bookId, categoryId])
  @@index([bookId, status])
  @@map("movements")
}

model AccountingPeriod {
  // Cada libro cierra sus propios meses: «2026-09» existe una vez por libro, no una sola vez.
  bookId   String
  period   String
  status   PeriodStatus @default(OPEN)
  closedAt DateTime?    @db.Timestamptz(3)

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([bookId, period])
  @@map("accounting_periods")
}

model BudgetModel {
  id        String         @id @default(uuid(7))
  bookId    String
  name      String
  active    Boolean        @default(false)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  buckets   BudgetBucket[]
  book      Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@map("budget_models")
}

model BudgetBucket {
  id           String   @id @default(uuid(7))
  bookId       String
  modelId      String
  bucketKey    String
  name         String
  percentage   Decimal  @db.Decimal(6, 3)
  isSavings    Boolean  @default(false)
  sortOrder    Int      @default(0)
  accountCodes String[]

  model BudgetModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  book  Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([modelId, bucketKey])
  @@index([bookId])
  @@map("budget_buckets")
}

model BudgetIncome {
  bookId      String
  period      String
  amountMinor BigInt
  currency    String @db.Char(3)

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([bookId, period])
  @@map("budget_income")
}

model Goal {
  id          String   @id @default(uuid(7))
  bookId      String
  name        String
  targetMinor BigInt
  currency    String   @db.Char(3)
  desiredDate DateTime @db.Date
  priority    Int      @default(0)
  accountCode String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  contributions GoalContribution[]
  book          Book               @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId, priority])
  @@map("goals")
}

model GoalContribution {
  id          String   @id @default(uuid(7))
  bookId      String
  goalId      String
  date        DateTime @db.Date
  amountMinor BigInt
  currency    String   @db.Char(3)

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId, goalId])
  @@map("goal_contributions")
}

enum InvestmentKind {
  FIXED_TERM
  OPEN
}

model Investment {
  id             String         @id @default(uuid(7))
  bookId         String
  name           String
  principalMinor BigInt
  currency       String         @db.Char(3)
  annualRate     Decimal        @db.Decimal(9, 6)
  compounding    Compounding
  openedAt       DateTime       @db.Date
  kind           InvestmentKind
  maturesAt      DateTime?      @db.Date
  accountCode    String?
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  contributions InvestmentContribution[]
  book          Book                     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId, maturesAt])
  @@map("investments")
}

model InvestmentContribution {
  id           String   @id @default(uuid(7))
  bookId       String
  investmentId String
  date         DateTime @db.Date
  amountMinor  BigInt
  currency     String   @db.Char(3)

  investment Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  book       Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId, investmentId])
  @@map("investment_contributions")
}

enum BankLineStatus {
  PENDING
  MATCHED
  IGNORED
}

model ImportProfile {
  id                 String   @id @default(uuid(7))
  bookId             String
  name               String
  delimiter          String   @db.Char(1)
  encoding           String
  headerRows         Int      @default(1)
  dateColumn         Int
  dateFormat         String
  descriptionColumn  Int
  referenceColumn    Int?
  amountColumn       Int?
  debitColumn        Int?
  creditColumn       Int?
  decimalSeparator   String   @db.Char(1)
  thousandsSeparator String?  @db.Char(1)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  accounts BankAccount[]
  book     Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@map("import_profiles")
}

model BankAccount {
  id          String   @id @default(uuid(7))
  bookId      String
  name        String
  accountCode String
  currency    String   @db.Char(3)
  profileId   String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  profile    ImportProfile?  @relation(fields: [profileId], references: [id])
  statements BankStatement[]
  lines      BankLine[]
  book       Book            @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@map("bank_accounts")
}

model BankStatement {
  id             String   @id @default(uuid(7))
  bookId         String
  bankAccountId  String
  fileName       String
  importedAt     DateTime @default(now()) @db.Timestamptz(3)
  lineCount      Int      @default(0)
  duplicateCount Int      @default(0)

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  lines       BankLine[]
  book        Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId, bankAccountId])
  @@map("bank_statements")
}

model BankLine {
  id            String         @id @default(uuid(7))
  bookId        String
  statementId   String
  bankAccountId String
  date          DateTime       @db.Date
  description   String
  reference     String?
  amountMinor   BigInt
  currency      String         @db.Char(3)
  hash          String
  status        BankLineStatus @default(PENDING)
  movementId    String?

  statement   BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  bankAccount BankAccount   @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  book        Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bankAccountId, hash])
  @@index([bookId, bankAccountId, status])
  @@index([bookId, date])
  @@map("bank_lines")
}

model AuthUser {
  id              String           @id
  name            String
  email           String
  emailVerified   Boolean          @default(false)
  image           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  authsessions    AuthSession[]
  authaccounts    AuthAccount[]
  bookmembers     BookMember[]
  bookinvitations BookInvitation[]

  @@unique([email])
  @@map("AuthUser")
}

model AuthSession {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  authuser             AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("AuthSession")
}

model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  authuser              AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("AuthAccount")
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("AuthVerification")
}

model Book {
  id                      String                   @id
  name                    String
  slug                    String
  logo                    String?
  createdAt               DateTime
  metadata                String?
  bookmembers             BookMember[]
  bookinvitations         BookInvitation[]
  debts                   Debt[]
  accounts                Account[]
  journalEntries          JournalEntry[]
  journalLines            JournalLine[]
  categories              Category[]
  movements               Movement[]
  accountingPeriods       AccountingPeriod[]
  budgetModels            BudgetModel[]
  budgetBuckets           BudgetBucket[]
  budgetIncomes           BudgetIncome[]
  goals                   Goal[]
  goalContributions       GoalContribution[]
  investments             Investment[]
  investmentContributions InvestmentContribution[]
  importProfiles          ImportProfile[]
  bankAccounts            BankAccount[]
  bankStatements          BankStatement[]
  bankLines               BankLine[]

  @@unique([slug])
  @@map("Book")
}

model BookMember {
  id             String   @id
  organizationId String
  book           Book     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  authuser       AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String   @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("BookMember")
}

model BookInvitation {
  id             String   @id
  organizationId String
  book           Book     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String   @default("pending")
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  inviterId      String
  authuser       AuthUser @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("BookInvitation")
}
