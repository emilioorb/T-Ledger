generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum DebtKind {
  FRENCH
  FIXED_PRINCIPAL
  INTEREST_FREE
}

enum Compounding {
  MONTHLY
  ANNUAL
}

enum DebtDirection {
  BORROWED
  LENT
}

model Debt {
  id             String        @id @default(uuid(7))
  name           String
  counterparty   String
  principalMinor BigInt
  currency       String        @db.Char(3)
  annualRate     Decimal       @db.Decimal(9, 6)
  compounding    Compounding
  termMonths     Int
  startDate      DateTime      @db.Date
  kind           DebtKind
  direction      DebtDirection @default(BORROWED)
  budgetBucket   String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  @@index([direction])
  @@map("debts")
}

model ExchangeRate {
  id          String   @id @default(uuid(7))
  indicator   String   @db.Char(3)
  value       Decimal  @db.Decimal(14, 6)
  publishedAt DateTime @db.Date
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([indicator, publishedAt])
  @@index([indicator, publishedAt(sort: Desc)])
  @@map("exchange_rates")
}
