{
  "name": "t-ledger-api",
  "version": "1.0.0",
  "description": "T-Ledger: finanzas personales con contabilidad de partida doble.",
  "license": "UNLICENSED",
  "author": "Emilio Rodríguez",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "openapi": "tsx scripts/escribir-openapi.ts",
    "datos:prueba": "npm run build && node --env-file=../.env dist/scripts/datos-de-prueba.js",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.json",
    "start:dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "prisma migrate deploy && node dist/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1137.0",
    "@aws-sdk/s3-request-presigner": "^3.1137.0",
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.3",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/node": "^10.75.1",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "better-auth": "^1.7.5",
    "decimal.js": "10.6.0",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "^12.0.3",
    "@nestjs/testing": "^12.0.3",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/express": "^5.0.5",
    "@types/node": "26.6.2",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.2.3",
    "eslint": "10.11.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
